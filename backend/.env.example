# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sourcesense:sourcesense@localhost:5432/sourcesense
SYNC_DATABASE_URL=postgresql://sourcesense:sourcesense@localhost:5432/sourcesense

# ── Relay / Trigger defaults ──────────────────────────────────────────────────
DEFAULT_PM10_THRESHOLD=50.0
DEFAULT_RELAY_DELAY_MINUTES=5

# ── Humidity correction defaults (Laulainen/Chakrabarti) ─────────────────────
DEFAULT_CALIB_A=0.33
DEFAULT_CALIB_B=0.17

# ── Alert credentials (leave blank to skip) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@sourcesense.io

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
